# Build artifacts
target/
*.rs.bk

# Buf-exported protos (run `just generate-proto` to fetch)
examples-proto/
angzarr-proto/

# Generated Rust code — emitted by `just generate-proto`. Never committed.
# See project_proto_generation_model.md.
proto/src/generated/*.rs
!proto/src/generated/.gitkeep

# Binaries
*/*/agg-*
*/*/saga-*
*/*/pmg-*
*/*/prj-*

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Kubernetes
*.kubeconfig

# cargo-mutants
mutants.out/
mutants.out.old/
# Ephemeral mutation build cache (compiled artifacts only, never mutated source)
.mutants-cache/
