# Rust poker examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI

set shell := ["bash", "-c"]

ROOT := `git rev-parse --show-toplevel`

default:
    @just --list

# Export proto definitions from angzarr-project submodule.
#
# `examples-proto/examples/*.proto` carries a flat layout the rust build.rs
# expects. The canonical protos declare `package angzarr_client.proto.examples`,
# so buf export lands them at `_proto_export/angzarr_client/proto/examples/`.
# Copy from there and rewrite the deep `angzarr_client/proto/examples/X.proto`
# imports to the flat `examples/X.proto` form so protoc can resolve them
# against the flat include root.
proto-gen:
    buf export angzarr-project/proto -o _proto_export
    rm -rf angzarr-proto examples-proto
    cp -r _proto_export angzarr-proto
    mkdir -p examples-proto/examples
    cp _proto_export/angzarr_client/proto/examples/*.proto examples-proto/examples/
    sed -i 's|angzarr_client/proto/examples/|examples/|g' examples-proto/examples/*.proto
    rm -rf _proto_export

# Build all workspace crates
build: proto-gen
    cargo build --workspace

# Build release binaries
build-release:
    cargo build --workspace --release

# Run all tests
test:
    cargo test --workspace

# Run clippy linter
lint:
    cargo clippy --workspace -- -D warnings

# Check formatting (use fmt-fix to auto-format)
fmt:
    cargo fmt --check

# Auto-format code
fmt-fix:
    cargo fmt

# Check code compiles
check:
    cargo check --workspace

# Run all checks (build + test + lint + fmt)
check-all: build test lint fmt

# Clean build artifacts
clean:
    cargo clean
    rm -rf data/

# === Additional Targets ===

# Build debug binaries
build-dev:
    cargo build --workspace

# Run unit tests only
test-unit:
    cargo test --workspace --lib

# Run acceptance/integration tests
test-acceptance:
    cargo test --workspace --test '*'

# Run in standalone mode (local development)
run: build-release
    mkdir -p "{{ROOT}}/data"
    cd "{{ROOT}}" && cargo run \
        --bin angzarr-standalone \
        --features standalone,sqlite \
        -- --config examples/rust/standalone.yaml

# Run mutation tests on aggregate packages (70% threshold over viable mutants)
mutation-test:
    #!/usr/bin/env bash
    set -uo pipefail
    # Per-mutant workspace copies are multi-GB and cargo-mutants must copy the
    # source tree. TMPDIR must be on disk (not tmpfs) AND outside the source
    # tree (otherwise each copy nests the previous one → ENAMETOOLONG).
    SCRATCH="${CARGO_MUTANTS_TMPDIR:-${RUNNER_TEMP:-$HOME/.cargo-mutants-scratch}}"
    mkdir -p "$SCRATCH"
    export TMPDIR="$SCRATCH"
    # cargo mutants exits 2 when any mutant is missed; don't let that abort the recipe
    # --jobs pins parallelism so CI doesn't default to 1 on 2-core runners.
    JOBS="${CARGO_MUTANTS_JOBS:-$(nproc 2>/dev/null || echo 2)}"
    # Optional PR-scope: mutate only code touched by a diff (CI sets this
    # from `git diff origin/<base>...HEAD`). Empty = full sweep.
    DIFF_ARGS=""
    if [ -n "${CARGO_MUTANTS_DIFF:-}" ] && [ -s "$CARGO_MUTANTS_DIFF" ]; then
        echo "Scoping mutation test to diff: $CARGO_MUTANTS_DIFF ($(wc -l < "$CARGO_MUTANTS_DIFF") lines)"
        DIFF_ARGS="--in-diff $CARGO_MUTANTS_DIFF"
    fi
    cargo mutants \
        --package agg-player \
        --package agg-table \
        --package agg-hand \
        --package agg-tournament \
        --test-workspace true \
        --jobs "$JOBS" \
        --minimum-test-timeout 60 \
        $DIFF_ARGS || true
    RESULTS="mutants.out/caught.txt"
    MISSED="mutants.out/missed.txt"
    CAUGHT=$(wc -l < "$RESULTS" 2>/dev/null || echo 0)
    MISSED_COUNT=$(wc -l < "$MISSED" 2>/dev/null || echo 0)
    TOTAL=$((CAUGHT + MISSED_COUNT))
    if [ "$TOTAL" -eq 0 ]; then
        if [ -n "${CARGO_MUTANTS_DIFF:-}" ]; then
            echo "No mutants in diff scope — nothing to gate."
            exit 0
        fi
        echo "No viable mutants generated — check package selection"
        exit 1
    fi
    SCORE=$((CAUGHT * 100 / TOTAL))
    echo "Mutation score: ${SCORE}% (${CAUGHT}/${TOTAL} caught, threshold: 70%)"
    if [ "$SCORE" -lt 70 ]; then
        echo "FAIL: Mutation score ${SCORE}% is below 70% threshold"
        echo "--- missed mutants ---"
        cat "$MISSED"
        exit 1
    fi

# Run in standalone mode (debug build)
run-dev: build-dev
    mkdir -p "{{ROOT}}/data"
    cargo run --manifest-path "{{ROOT}}/Cargo.toml" \
        --bin angzarr-standalone \
        --features standalone,sqlite \
        -- --config "{{ROOT}}/standalone.yaml"
