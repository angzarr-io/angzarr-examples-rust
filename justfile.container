# Rust examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI
#
# Cargo recipes skip when the checkout has no Cargo.toml.

set shell := ["bash", "-c"]

# The checkout root: this file sits at the top (mounted over `justfile` in the
# container, read in place in CI). Independent of git, so a git worktree whose
# .git points outside the mount works too.
ROOT := justfile_directory()

default:
    @just --list

# Run cargo when the workspace has crates; skip otherwise
[private]
_cargo +ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{ROOT}}/Cargo.toml" ]; then
        echo "No Cargo workspace yet; skipping 'cargo {{ARGS}}'"
        exit 0
    fi
    cd "{{ROOT}}" && cargo {{ARGS}}

# Build all workspace crates
build: (_cargo "build" "--workspace")

# Build release binaries
build-release: (_cargo "build" "--workspace" "--release")

# Run all tests
test: (_cargo "test" "--workspace")

# Run clippy linter
lint: (_cargo "clippy" "--workspace" "--" "-D" "warnings")

# Check formatting (use fmt-fix to auto-format)
fmt: (_cargo "fmt" "--check")

# Auto-format code
fmt-fix: (_cargo "fmt")

# Check code compiles
check: (_cargo "check" "--workspace")

# Architecture lint: check the workspace's module dependency graph against
# the layer rules in archlint.toml (tools/archlint). `cargo run -p archlint --
# --edges` prints the model the rules are checked against.
archlint:
    cargo run --manifest-path {{ROOT}}/Cargo.toml --quiet -p archlint -- --rules {{ROOT}}/archlint.toml --manifest-path {{ROOT}}/Cargo.toml

# Run all checks (build + test + lint + fmt)
check-all: build test lint fmt

# Clean build artifacts
clean: (_cargo "clean")
    rm -rf data/

# Build debug binaries
build-dev: (_cargo "build" "--workspace")

# Run unit tests only
test-unit: (_cargo "test" "--workspace" "--lib")

# Run acceptance/integration tests
test-acceptance: (_cargo "test" "--workspace" "--test" "'*'")

# Mutation kill-rate thresholds, percent, by crate path: a mutant is judged by
# the longest prefix its file is under, and one under none fails the gate, so a
# crate added to MUTATED gets a threshold first. 90% is the owner's bar for
# every crate (2026-10-29).
MUTATION_THRESHOLDS := "table/agg=90 table/policies=90 table/embedded=90"
# The crates mutated: the aggregate, the player policies and the embedded host.
MUTATED := "--package agg-table --package table-player-policies --package table-embedded"

# Mutation-test the MUTATED crates (the full pass), judged per crate by
# MUTATION_THRESHOLDS over viable mutants (caught or timed out = killed).
mutation-test: (_mutation "")

# Mutation-test only the lines of the MUTATED crates that the diff PATCH
# (relative to the checkout, a/ and b/ paths) changes, judged the same way:
# the host `mutation-push`'s run (by hand), in the pushed commit's tree. Exits 4 when the
# tests fail unmutated (cargo-mutants' baseline), so no mutant can be judged.
mutation-diff PATCH: (_mutation PATCH)

[private]
_mutation PATCH:
    #!/usr/bin/env bash
    set -uo pipefail
    cd "{{ROOT}}"
    # The devcontainer image does not ship cargo-mutants; install it into
    # the (cached) CARGO_HOME on first use.
    if ! command -v cargo-mutants >/dev/null; then
        cargo install cargo-mutants --locked || exit 1
    fi
    # Per-mutant workspace copies are multi-GB and cargo-mutants must copy the
    # source tree. TMPDIR must be on disk (not tmpfs) AND outside the source
    # tree (otherwise each copy nests the previous one → ENAMETOOLONG).
    SCRATCH="${CARGO_MUTANTS_TMPDIR:-${RUNNER_TEMP:-$HOME/.cargo-mutants-scratch}}"
    mkdir -p "$SCRATCH"
    export TMPDIR="$SCRATCH"
    # --jobs pins parallelism so CI doesn't default to 1 on 2-core runners.
    JOBS="${CARGO_MUTANTS_JOBS:-$(nproc 2>/dev/null || echo 2)}"
    # Diff scope: PATCH, else CARGO_MUTANTS_DIFF (a CI may set it from `git
    # diff origin/<base>...HEAD`). Neither = full sweep.
    DIFF="{{PATCH}}"
    [ -n "$DIFF" ] || DIFF="${CARGO_MUTANTS_DIFF:-}"
    DIFF_ARGS=()
    if [ -n "$DIFF" ] && [ -s "$DIFF" ]; then
        echo "Scoping mutation test to diff: $DIFF ($(wc -l < "$DIFF") lines)"
        DIFF_ARGS=(--in-diff "$DIFF")
    fi
    rm -rf mutants.out
    rc=0
    cargo mutants {{MUTATED}} \
        --test-workspace true \
        --jobs "$JOBS" \
        --minimum-test-timeout 60 \
        "${DIFF_ARGS[@]}" || rc=$?
    # 0: all caught; 2: missed; 3: timeouts (judged below). 4: the tests fail
    # unmutated, so nothing can be judged; anything else: no verdict.
    case "$rc" in
        0|2|3) ;;
        4) echo "FAIL: the tests fail unmutated (cargo-mutants baseline); no mutant can be judged"; exit 4 ;;
        *) echo "FAIL: cargo mutants failed before a verdict (exit $rc)"; exit 1 ;;
    esac
    # Each outcome file holds a line per mutant, "<file>:<line>:<col>: ...".
    killed_files=$(cat mutants.out/caught.txt mutants.out/timeout.txt 2>/dev/null | cut -d: -f1)
    missed_files=$(cut -d: -f1 mutants.out/missed.txt 2>/dev/null)
    if [ -z "$killed_files" ] && [ -z "$missed_files" ]; then
        if [ -n "$DIFF" ]; then
            echo "No mutants in diff scope — nothing to gate."
            exit 0
        fi
        echo "No viable mutants generated — check package selection"
        exit 1
    fi
    read -ra tiers <<< "{{MUTATION_THRESHOLDS}}"
    # A mutant's tier: the longest prefix its file is under.
    tier_of() {
        local best= t
        for t in "${tiers[@]}"; do
            case "$1" in "${t%%=*}"/*) [ "${#t}" -gt "${#best}" ] && best=$t ;; esac
        done
        echo "$best"
    }
    declare -A killed=() missed=()
    untiered=()
    while read -r f; do
        [ -n "$f" ] || continue
        t=$(tier_of "$f")
        if [ -z "$t" ]; then untiered+=("$f"); else killed[$t]=$(( ${killed[$t]:-0} + 1 )); fi
    done <<< "$killed_files"
    while read -r f; do
        [ -n "$f" ] || continue
        t=$(tier_of "$f")
        if [ -z "$t" ]; then untiered+=("$f"); else missed[$t]=$(( ${missed[$t]:-0} + 1 )); fi
    done <<< "$missed_files"
    if [ "${#untiered[@]}" -gt 0 ]; then
        echo "FAIL: no threshold in MUTATION_THRESHOLDS for: $(printf '%s\n' "${untiered[@]}" | sort -u | paste -sd ' ')"
        exit 1
    fi
    failed=0
    for t in "${tiers[@]}"; do
        k=${killed[$t]:-0} m=${missed[$t]:-0}
        [ $((k + m)) -gt 0 ] || continue
        min=${t#*=}
        if [ $((k * 100)) -ge $((min * (k + m))) ]; then verdict=pass; else verdict=FAIL; failed=1; fi
        echo "$verdict  ${t%%=*}: $k/$((k + m)) killed ($((k * 100 / (k + m)))%), threshold $min%"
    done
    if [ "$failed" = 1 ]; then
        echo "--- missed mutants ---"
        cat mutants.out/missed.txt
        exit 1
    fi
