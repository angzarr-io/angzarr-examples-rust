# Rust examples - container version
# This file is mounted as 'justfile' inside the container
# Also used directly in CI
#
# Cargo recipes skip when the checkout has no Cargo.toml.

set shell := ["bash", "-c"]

# The checkout root: this file sits at the top (mounted over `justfile` in the
# container, read in place in CI). Independent of git, so a git worktree whose
# .git points outside the mount works too.
ROOT := justfile_directory()

default:
    @just --list

# Run cargo when the workspace has crates; skip otherwise
[private]
_cargo +ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    if [ ! -f "{{ROOT}}/Cargo.toml" ]; then
        echo "No Cargo workspace yet; skipping 'cargo {{ARGS}}'"
        exit 0
    fi
    cd "{{ROOT}}" && cargo {{ARGS}}

# Build all workspace crates
build: (_cargo "build" "--workspace")

# Build release binaries
build-release: (_cargo "build" "--workspace" "--release")

# Run all tests
test: (_cargo "test" "--workspace")

# Run clippy linter
lint: (_cargo "clippy" "--workspace" "--" "-D" "warnings")

# Check formatting (use fmt-fix to auto-format)
fmt: (_cargo "fmt" "--check")

# Auto-format code
fmt-fix: (_cargo "fmt")

# Check code compiles
check: (_cargo "check" "--workspace")

# Architecture lint: check the workspace's module dependency graph against
# the layer rules in archlint.toml (tools/archlint). `cargo run -p archlint --
# --edges` prints the model the rules are checked against.
archlint:
    cargo run --manifest-path {{ROOT}}/Cargo.toml --quiet -p archlint -- --rules {{ROOT}}/archlint.toml --manifest-path {{ROOT}}/Cargo.toml

# Run all checks (build + test + lint + fmt)
check-all: build test lint fmt

# Clean build artifacts
clean: (_cargo "clean")
    rm -rf data/

# Build debug binaries
build-dev: (_cargo "build" "--workspace")

# Run unit tests only
test-unit: (_cargo "test" "--workspace" "--lib")

# Run acceptance/integration tests
test-acceptance: (_cargo "test" "--workspace" "--test" "'*'")
